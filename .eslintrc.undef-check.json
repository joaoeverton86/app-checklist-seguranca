{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "EQUIPMENT_TYPES": "readonly",
    "ITEM_NAMES": "readonly",
    "CATEGORY_ICONS": "readonly",
    "EXTINTOR_TIPOS": "readonly",
    "EXTINTOR_INSPECTION_ITEMS": "readonly",
    "jspdf": "readonly",
    "Chart": "readonly",
    "XLSX": "readonly",
    "jsQR": "readonly",
    "qrcode": "readonly",
    "dcodeIO": "readonly",
    "sendPrompt": "readonly",
    "supabase": "readonly",
    "docx": "readonly",
    "LOGO_COP_BASE64": "writable",
    "showToast": "readonly",
    "mostrarFeedbackToast": "readonly",
    "usuarioLogadoPainel": "readonly",
    "usuarioLogadoNome": "readonly",
    "abrirPaginaPlacarLideres": "readonly",
    "filterMatrizEpi": "readonly",
    "abrirDocumentoHtmlParaImpressao": "readonly"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "off"
  }
}
