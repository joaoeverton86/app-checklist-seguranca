{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Live Server: Dashboard SST (Porta 5500)",
      "url": "http://127.0.0.1:5500/dashboard/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Live Server: App Campo PWA (Porta 5500)",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Servidor Node HTTPS Local (Porta 8000)",
      "url": "https://localhost:8000/dashboard/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}